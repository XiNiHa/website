---
import Section from '@/components/Section'

interface Props {
  lang?: string
}

const { lang = 'ko' } = Astro.props

const textKo = [
  ['안녕하세요! 신의하입니다.'],
  ['모두의 개발 환경을 개선하는 일에', '가장 큰 보람을 느끼는', '프론트엔드 엔지니어이며,'],
  ['주도적으로 문제를 정의한 후', '생태계 지식과 하드 스킬을 기반으로', '어려운 문제도 끈기 있게 해결합니다.'],
  ['장기적 관점에서', '최선의 결과물을 만들기 위해', '항상 고민하고 노력합니다.']
]
const textEn = [
  ['Hello! I am Iha Shin.'],
  ['I always have loved to code,', 'so I became a software engineer.'],
  ['I enjoy working with the Web,', 'especially in the frontend area.'],
  ['I am always looking for new things to', 'learn, study, and try.'],
]

const text = lang === 'ko' ? textKo : textEn
---

<Section id="about" title="About me" client:idle>
  <div class="py-4 text-xl leading-[1.8] print:(py-2 text-lg leading-[1.4])">
    {
      text.map(segments => (
        <p>
          {segments.map(seg => (
            <>
              <span class="whitespace-nowrap">{seg}</span>{' '}
            </>
          ))}
        </p>
      ))
    }
  </div>
</Section>

<style>
  section#about astro-slot {
    height: 100%;
  }
</style>
